// Cafe Coding theme — merge into your VS Code settings.json
// (Cmd/Ctrl+Shift+P → "Preferences: Open User Settings (JSON)")
// Fonts: Geist (UI) and Geist Mono (code) — https://vercel.com/font
{
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 26,
  "editor.fontLigatures": false,
  "editor.cursorBlinking": "smooth",
  "editor.cursorWidth": 2,
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "all",
  "editor.guides.indentation": false,
  "editor.padding.top": 18,
  "editor.scrollBeyondLastLine": false,
  "breadcrumbs.enabled": false,
  "window.titleBarStyle": "custom",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 14,
  "workbench.activityBar.location": "default",
  "terminal.integrated.fontFamily": "'Geist Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": true,

  "workbench.colorCustomizations": {
    "[*]": {
      "foreground": "#E8E6E1",
      "focusBorder": "#6EE7B7",
      "editor.background": "#0B0D10",
      "editor.foreground": "#C9C6BF",
      "editor.lineHighlightBackground": "#11151B",
      "editor.lineHighlightBorder": "#11151B",
      "editor.selectionBackground": "#6EE7B733",
      "editorLineNumber.foreground": "#4A505C",
      "editorLineNumber.activeForeground": "#9AA0AB",
      "editorCursor.foreground": "#6EE7B7",
      "editorWidget.background": "#0F1216",
      "editorGroupHeader.tabsBackground": "#0B0D10",
      "editorGroup.border": "#1B1F26",
      "tab.activeBackground": "#0B0D10",
      "tab.inactiveBackground": "#0B0D10",
      "tab.activeForeground": "#F4F2EE",
      "tab.inactiveForeground": "#6B7280",
      "tab.activeBorderTop": "#0B0D10",
      "tab.activeBorder": "#6EE7B7",
      "tab.border": "#0B0D10",
      "sideBar.background": "#0B0D10",
      "sideBar.border": "#1B1F26",
      "sideBar.foreground": "#8A909B",
      "sideBarTitle.foreground": "#5B6270",
      "sideBarSectionHeader.background": "#0B0D10",
      "list.activeSelectionBackground": "#14181E",
      "list.activeSelectionForeground": "#F4F2EE",
      "list.inactiveSelectionBackground": "#14181E",
      "list.hoverBackground": "#11151B",
      "activityBar.background": "#0B0D10",
      "activityBar.border": "#1B1F26",
      "activityBar.foreground": "#6EE7B7",
      "activityBar.inactiveForeground": "#5B6270",
      "activityBar.activeBorder": "#6EE7B7",
      "titleBar.activeBackground": "#0B0D10",
      "titleBar.inactiveBackground": "#0B0D10",
      "titleBar.activeForeground": "#7A808C",
      "titleBar.border": "#1B1F26",
      "statusBar.background": "#0B0D10",
      "statusBar.foreground": "#7A808C",
      "statusBar.border": "#1B1F26",
      "statusBar.noFolderBackground": "#0B0D10",
      "statusBarItem.hoverBackground": "#14181E",
      "panel.background": "#090B0E",
      "panel.border": "#1B1F26",
      "panelTitle.activeForeground": "#F4F2EE",
      "panelTitle.activeBorder": "#6EE7B7",
      "panelTitle.inactiveForeground": "#5B6270",
      "terminal.background": "#090B0E",
      "terminal.foreground": "#C9C6BF",
      "terminalCursor.foreground": "#6EE7B7",
      "terminal.ansiBlack": "#1B1F26",
      "terminal.ansiRed": "#FF7A90",
      "terminal.ansiGreen": "#6EE7B7",
      "terminal.ansiYellow": "#F2C078",
      "terminal.ansiBlue": "#8AB4FF",
      "terminal.ansiMagenta": "#B4A7FF",
      "terminal.ansiCyan": "#6EE7B7",
      "terminal.ansiWhite": "#C9C6BF",
      "terminal.ansiBrightBlack": "#5B6270",
      "terminal.ansiBrightRed": "#FF7A90",
      "terminal.ansiBrightGreen": "#6EE7B7",
      "terminal.ansiBrightYellow": "#F2C078",
      "terminal.ansiBrightBlue": "#8AB4FF",
      "terminal.ansiBrightMagenta": "#B4A7FF",
      "terminal.ansiBrightCyan": "#6EE7B7",
      "terminal.ansiBrightWhite": "#F4F2EE",
      "scrollbarSlider.background": "#1B1F2680",
      "scrollbarSlider.hoverBackground": "#2A2F38",
      "input.background": "#0F1216",
      "input.border": "#1B1F26",
      "badge.background": "#6EE7B7",
      "badge.foreground": "#0B0D10"
    }
  },

  "editor.tokenColorCustomizations": {
    "[*]": {
      "comments": { "foreground": "#5B6270", "fontStyle": "italic" },
      "keywords": "#B4A7FF",
      "strings": "#F2C078",
      "numbers": "#F2C078",
      "types": "#6EE7B7",
      "functions": { "foreground": "#F4F2EE", "fontStyle": "bold" },
      "variables": "#C9C6BF"
    }
  }
}
